# Salin file ini menjadi .env untuk kerja lokal.
# Di Netlify, isi nilai yang sama di Site configuration > Environment variables.

# --- AI (hanya dibaca oleh netlify/functions/ai.ts, tidak pernah masuk ke browser) ---
# Kosong = mode AI MOCK (jawaban dari mock/ai-responses.json).
ANTHROPIC_API_KEY=
# Wajib diisi jika ANTHROPIC_API_KEY diisi. Pengguna memasukkan kode ini sekali di UI.
DEMO_ACCESS_CODE=
# Opsional. Default: claude-sonnet-5-5
AI_MODEL=
# Opsional. low | medium | high. Default: low (jawaban lebih cepat untuk demo).
AI_EFFORT=
# Opsional. Batas atas max_tokens per panggilan. Default: 8000
AI_MAX_TOKENS=

# --- Data (dibaca oleh browser, awalan VITE_ wajib) ---
# mock | supabase. Default: mock
VITE_DATA_SOURCE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
